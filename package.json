{
  "name": "dsh-project-status",
  "version": "1.0.0",
  "type": "module",
  "description": "Show a status dot on every sidebar project row and a sticky active-sessions area that lists waiting, running, and finished sessions",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "kelimaca",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "sidebar",
    "session-status"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zchiy2k/dsh-project-status.git"
  },
  "homepage": "https://github.com/zchiy2k/dsh-project-status#readme",
  "bugs": {
    "url": "https://github.com/zchiy2k/dsh-project-status/issues"
  }
}
